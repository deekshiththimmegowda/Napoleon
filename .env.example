# ===============================================
# ULTIMATE LLM SCRAPER CONFIGURATION
# ===============================================
# Copy this file to .env and fill in your actual values

# ===============================================
# REQUIRED API KEYS
# ===============================================

# GitHub API Token (Required)
# Get from: https://github.com/settings/tokens
# Permissions needed: public_repo access
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Google Sheets Service Account (Required)
# Create service account at: https://console.cloud.google.com/
# Download JSON file and save as service_account.json
GOOGLE_APPLICATION_CREDENTIALS=service_account.json

# ===============================================
# OPTIONAL API KEYS (Enhance functionality)
# ===============================================

# SerpAPI Key (for Twitter/social media fallback scraping)
# Get from: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# Reddit API (for Reddit community scraping)
# Get from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=UltimateLLMScraper/1.0

# ===============================================
# CRM & OUTREACH INTEGRATIONS
# ===============================================

# HubSpot API (for CRM integration)
# Get from: HubSpot Settings > Integrations > API Key
HUBSPOT_API_KEY=your_hubspot_api_key_here
HUBSPOT_PORTAL_ID=your_hubspot_portal_id

# Smartlead.ai API (for email automation)
# Get from: Smartlead.ai dashboard > API section
SMARTLEAD_API_KEY=your_smartlead_api_key_here

# ===============================================
# ENRICHMENT SERVICES
# ===============================================

# PeopleDataLabs (for contact enrichment)
# Get from: https://www.peopledatalabs.com/
PEOPLEDATALABS_API_KEY=your_pdl_api_key_here

# Clearbit API (alternative enrichment service)
# Get from: https://clearbit.com/
CLEARBIT_API_KEY=your_clearbit_api_key_here

# Hunter.io (for email finding)
# Get from: https://hunter.io/
HUNTER_API_KEY=your_hunter_api_key_here

# ===============================================
# SOCIAL MEDIA AUTOMATION
# ===============================================

# LinkedIn Automation (PhantomBuster/Dripify)
PHANTOMBUSTER_API_KEY=your_phantombuster_api_key
DRIPIFY_API_KEY=your_dripify_api_key

# Twitter/X API v2 (for advanced Twitter features)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# ===============================================
# EMAIL SERVICES
# ===============================================

# SendGrid (for transactional emails)
SENDGRID_API_KEY=your_sendgrid_api_key

# Mailgun (alternative email service)
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_mailgun_domain

# ===============================================
# NOTIFICATION & MONITORING
# ===============================================

# Slack (for notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Discord (for community notifications)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/discord/webhook
DISCORD_BOT_TOKEN=your_discord_bot_token

# ===============================================
# GOOGLE SHEETS CONFIGURATION
# ===============================================

# Main Google Sheet Name (where contacts are stored)
SHEET_NAME=OptiML Hiring Contacts

# Additional sheet configurations
BACKUP_SHEET_NAME=OptiML Contacts Backup
ANALYTICS_SHEET_NAME=OptiML Analytics Dashboard

# ===============================================
# SCRAPING CONFIGURATION
# ===============================================

# Rate limiting settings (requests per minute)
GITHUB_RATE_LIMIT=4000
HUGGINGFACE_RATE_LIMIT=100
SEMANTIC_SCHOLAR_RATE_LIMIT=50

# Maximum contacts per platform per run
MAX_GITHUB_CONTACTS=2000
MAX_HUGGINGFACE_CONTACTS=500
MAX_ACADEMIC_CONTACTS=300
MAX_TWITTER_CONTACTS=200
MAX_REDDIT_CONTACTS=100

# Minimum hire score threshold
MIN_HIRE_SCORE=3.0

# ===============================================
# OUTREACH CAMPAIGN SETTINGS
# ===============================================

# Email campaign settings
DAILY_EMAIL_LIMIT=25
INBOX_ROTATION_COUNT=10
FOLLOW_UP_DELAY_DAYS=3

# LinkedIn settings
DAILY_CONNECTION_REQUESTS=50
DAILY_LINKEDIN_MESSAGES=30

# Twitter settings
DAILY_TWITTER_FOLLOWS=100
DAILY_TWITTER_DMS=20

# ===============================================
# DATABASE CONFIGURATION (Optional)
# ===============================================

# PostgreSQL (for advanced analytics)
DATABASE_URL=postgresql://username:password@localhost:5432/llm_contacts

# MongoDB (for document storage)
MONGODB_URI=mongodb://localhost:27017/llm_scraper

# ===============================================
# ADVANCED FEATURES
# ===============================================

# Webhook endpoints for real-time notifications
HIGH_PRIORITY_WEBHOOK=https://your-app.com/webhooks/high-priority-contact
NEW_CONTACT_WEBHOOK=https://your-app.com/webhooks/new-contact

# AI/ML Services (for advanced scoring)
OPENAI_API_KEY=your_openai_api_key_for_bio_analysis
ANTHROPIC_API_KEY=your_anthropic_api_key

# Image processing (for profile picture analysis)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ===============================================
# ENVIRONMENT SETTINGS
# ===============================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable debug mode
DEBUG=false

# Timezone for scheduling
TIMEZONE=UTC

# ===============================================
# SECURITY SETTINGS
# ===============================================

# Encryption key for sensitive data
ENCRYPTION_KEY=your_32_character_encryption_key_here

# API request timeout (seconds)
REQUEST_TIMEOUT=30

# Maximum retry attempts
MAX_RETRIES=3

# ===============================================
# PROXY SETTINGS (if needed)
# ===============================================

# HTTP Proxy
HTTP_PROXY=http://proxy.example.com:8080

# HTTPS Proxy  
HTTPS_PROXY=https://proxy.example.com:8080

# Proxy authentication
PROXY_USERNAME=your_proxy_username
PROXY_PASSWORD=your_proxy_password

# ===============================================
# EXAMPLE CONFIGURATIONS FOR DIFFERENT SETUPS
# ===============================================

# For testing/development (minimal setup):
# - Only GITHUB_TOKEN and Google Sheets are required
# - All other services are optional

# For production (full automation):
# - Add HubSpot and Smartlead for complete pipeline
# - Include enrichment APIs for better data quality
# - Set up monitoring with Slack/Discord

# For high-volume scraping:
# - Configure multiple GitHub tokens for higher rate limits
# - Set up proxy rotation for IP management
# - Use database for better performance

# ===============================================
# NOTES & TIPS
# ===============================================

# 1. Never commit the actual .env file to version control
# 2. Use environment-specific .env files (.env.dev, .env.prod)
# 3. Regularly rotate API keys for security
# 4. Monitor API usage to avoid unexpected charges
# 5. Test with small datasets before running full scrapes
# 6. Keep backup copies of important configuration